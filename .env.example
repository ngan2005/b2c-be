# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; this template is committed so contributors know which keys are required.

# Database password (Supabase)
# Read by application-dev.properties via ${DB_PASSWORD:postgres}.
DB_PASSWORD="REPLACE_WITH_SUPABASE_PASSWORD"

# JWT secret key (>= 32 ky tu bat ky, duy nhat)
# Must be valid Base64 (A-Z, a-z, 0-9, +, /, =) since JwtTokenProvider decodes with Decoders.BASE64.
# Use a base64-encoded version of any long random string.
JWT_SECRET_KEY="REPLACE_WITH_BASE64_32BYTE_RANDOM"

# OpenAI key for AI assistant / product description generator
OPENAI_API_KEY="REPLACE_WITH_OPENAI_KEY"