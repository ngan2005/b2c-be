# ==========================================
# DATABASE (PostgreSQL / Supabase)
# ==========================================
# If using the shared Supabase dev DB, supply the password here:
DB_PASSWORD="your_db_password_here"
# Optional overrides for local Postgres:
# SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/b2c"
# SPRING_DATASOURCE_USERNAME="postgres"

# ==========================================
# SECURITY (JWT)
# ==========================================
# HS256 base64 secret (must be at least 256 bits)
JWT_SECRET_KEY="your_base64_jwt_secret_key_here"

# ==========================================
# CLOUDINARY (Media & Image Uploads)
# ==========================================
# Set provider to "cloudinary" or "disabled" (if disabled, uploads are bypassed)
APP_STORAGE_PROVIDER="disabled"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="b2c"
CLOUDINARY_MAX_FILE_SIZE_BYTES="5242880"

# ==========================================
# GOOGLE OAUTH2 (Optional)
# ==========================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_OAUTH2_REDIRECT_URI="http://localhost:5173/oauth/callback"

# ==========================================
# VNPAY SANDBOX (Payment Gateway - Optional)
# ==========================================
# Register at https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_RETURN_URL="http://localhost:5173/payment/return"

# ==========================================
# SPRING AI / OPENAI (Optional)
# ==========================================
OPENAI_API_KEY=""

# ==========================================
# EMAIL / SMTP (Mã OTP & Quên mật khẩu)
# ==========================================
# Chọn "smtp" để gửi mail thật, hoặc "logging" để in OTP ra console + dev-outbox.log
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM=""
PASSWORD_RESET_TTL_MINUTES="5"
# ==========================================
# VNPAY SANDBOX (Payment Gateway)
# ==========================================
# Điền mã TMN_CODE và HASH_SECRET lấy từ https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_RETURN_URL="https://panther-flatness-unzip.ngrok-free.dev/api/v1/payments/return"

